---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../data/site-config";
---

<Layout title="Contact" description="Get in touch about a new website, redesign, or maintenance plan.">
	<section class="mx-auto max-w-3xl px-6 py-16 sm:py-24">
		<h1 class="font-head text-4xl font-semibold text-ink sm:text-5xl">Get in touch</h1>
		<p class="mt-4 text-lg leading-relaxed text-ink/75">
			Tell me a bit about your business and what you need. I read every message myself
			and I'll get back to you within a day or two.
		</p>

		<form id="contact-form" class="mt-10 space-y-5">
			<div class="grid gap-5 sm:grid-cols-2">
				<div>
					<label for="name" class="block text-sm font-semibold text-ink">Name</label>
					<input
						id="name"
						name="name"
						type="text"
						required
						class="mt-1.5 w-full rounded-md border border-ink/20 bg-paper px-3.5 py-2.5 text-ink placeholder:text-ink/40 focus:border-primary focus:outline-none"
					/>
				</div>
				<div>
					<label for="business" class="block text-sm font-semibold text-ink">Business</label>
					<input
						id="business"
						name="business"
						type="text"
						class="mt-1.5 w-full rounded-md border border-ink/20 bg-paper px-3.5 py-2.5 text-ink placeholder:text-ink/40 focus:border-primary focus:outline-none"
					/>
				</div>
			</div>
			<div>
				<label for="email" class="block text-sm font-semibold text-ink">Email</label>
				<input
					id="email"
					name="email"
					type="email"
					required
					class="mt-1.5 w-full rounded-md border border-ink/20 bg-paper px-3.5 py-2.5 text-ink placeholder:text-ink/40 focus:border-primary focus:outline-none"
				/>
			</div>
			<div>
				<label for="message" class="block text-sm font-semibold text-ink">Message</label>
				<textarea
					id="message"
					name="message"
					rows="5"
					required
					class="mt-1.5 w-full rounded-md border border-ink/20 bg-paper px-3.5 py-2.5 text-ink placeholder:text-ink/40 focus:border-primary focus:outline-none"
				></textarea>
			</div>
			<button
				type="submit"
				class="inline-block rounded-md bg-primary px-6 py-3 text-sm font-semibold text-paper transition-colors hover:bg-primary/90"
			>
				Send message
			</button>
			<p class="text-xs text-ink/50">
				This opens a message in your email app addressed to {siteConfig.email}, prefilled with what you enter above.
			</p>
		</form>

		<div class="mt-14 border-t border-ink/10 pt-8">
			<p class="text-sm font-semibold text-ink">Prefer to reach out directly?</p>
			<div class="mt-3 flex flex-wrap gap-x-8 gap-y-2 text-sm">
				<a href={`mailto:${siteConfig.email}`} class="font-semibold text-accent hover:text-accent/80">{siteConfig.email}</a>
				<a href={siteConfig.linkedin} target="_blank" rel="noopener noreferrer" class="font-semibold text-accent hover:text-accent/80">
					LinkedIn →
				</a>
			</div>
		</div>
	</section>
</Layout>

<script define:vars={{ email: siteConfig.email }}>
	const form = document.getElementById("contact-form");

	form?.addEventListener("submit", (event) => {
		event.preventDefault();
		const data = new FormData(form);
		const name = data.get("name") ?? "";
		const business = data.get("business") ?? "";
		const senderEmail = data.get("email") ?? "";
		const message = data.get("message") ?? "";

		const subject = `New inquiry from ${name}${business ? ` (${business})` : ""}`;
		const body = `Name: ${name}\nBusiness: ${business}\nEmail: ${senderEmail}\n\n${message}`;

		window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
	});
</script>
