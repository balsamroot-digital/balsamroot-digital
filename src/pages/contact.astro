---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../data/site-config";
---

<Layout title="Contact" description="Get in touch about a new website, redesign, or maintenance plan.">
	<section class="mx-auto max-w-3xl px-6 py-16 sm:py-24">
		<h1 class="font-head text-4xl font-semibold text-ink sm:text-5xl">Get in touch</h1>
		<p class="mt-4 text-lg leading-relaxed text-ink/75">
			Tell me a bit about your business and what you need. I read every message myself
			and I'll get back to you within a day or two.
		</p>

		<form
			id="contact-form"
			name="contact"
			method="POST"
			data-netlify="true"
			netlify-honeypot="bot-field"
			class="mt-10 space-y-5"
		>
			<input type="hidden" name="form-name" value="contact" />
			<p class="hidden">
				<label>Don't fill this out if you're human: <input name="bot-field" /></label>
			</p>

			<div class="grid gap-5 sm:grid-cols-2">
				<div>
					<label for="name" class="block text-sm font-semibold text-ink">Name</label>
					<input
						id="name"
						name="name"
						type="text"
						maxlength="100"
						required
						class="mt-1.5 w-full rounded-md border border-ink/20 bg-paper px-3.5 py-2.5 text-ink placeholder:text-muted focus:border-primary focus:outline-none"
					/>
				</div>
				<div>
					<label for="business" class="block text-sm font-semibold text-ink">Business</label>
					<input
						id="business"
						name="business"
						type="text"
						maxlength="100"
						class="mt-1.5 w-full rounded-md border border-ink/20 bg-paper px-3.5 py-2.5 text-ink placeholder:text-muted focus:border-primary focus:outline-none"
					/>
				</div>
			</div>
			<div>
				<label for="email" class="block text-sm font-semibold text-ink">Email</label>
				<input
					id="email"
					name="email"
					type="email"
					maxlength="254"
					required
					class="mt-1.5 w-full rounded-md border border-ink/20 bg-paper px-3.5 py-2.5 text-ink placeholder:text-muted focus:border-primary focus:outline-none"
				/>
			</div>
			<div>
				<label for="message" class="block text-sm font-semibold text-ink">Message</label>
				<textarea
					id="message"
					name="message"
					rows="5"
					maxlength="5000"
					required
					class="mt-1.5 w-full rounded-md border border-ink/20 bg-paper px-3.5 py-2.5 text-ink placeholder:text-muted focus:border-primary focus:outline-none"
				></textarea>
				<p id="message-counter" class="mt-1.5 hidden text-right text-xs text-ink/70" aria-hidden="true"></p>
				<p id="message-counter-status" class="sr-only" role="status" aria-live="polite"></p>
			</div>

			<button
				id="contact-submit"
				type="submit"
				class="inline-block rounded-md bg-primary px-6 py-3 text-sm font-semibold text-paper transition-colors hover:bg-primary/90 disabled:opacity-60"
			>
				Send message
			</button>
		</form>

		<p id="contact-status" class="mt-5 hidden text-sm" role="status"></p>

		<div class="mt-14 border-t border-ink/10 pt-8">
			<p class="text-sm font-semibold text-ink">Prefer to reach out directly?</p>
			<div class="mt-3 flex flex-wrap gap-x-8 gap-y-2 text-sm">
				<a href={`mailto:${siteConfig.email}`} class="font-semibold text-accent hover:underline">{siteConfig.email}</a>
				<a href={siteConfig.linkedin} target="_blank" rel="noopener noreferrer" class="font-semibold text-accent hover:underline">
					LinkedIn →
				</a>
			</div>
		</div>
	</section>
</Layout>

<script>
	const form = document.getElementById("contact-form") as HTMLFormElement | null;
	const submitButton = document.getElementById("contact-submit") as HTMLButtonElement | null;
	const status = document.getElementById("contact-status");

	function encode(data: Record<string, string>) {
		return Object.entries(data)
			.map(([key, value]) => `${encodeURIComponent(key)}=${encodeURIComponent(value)}`)
			.join("&");
	}

	function showStatus(message: string, isError = false) {
		if (!status) return;
		status.textContent = message;
		status.classList.remove("hidden", "text-ink/70", "text-red-700");
		status.classList.add(isError ? "text-red-700" : "text-ink/70");
	}

	const messageField = document.getElementById("message") as HTMLTextAreaElement | null;
	const counter = document.getElementById("message-counter");
	const counterStatus = document.getElementById("message-counter-status");
	const COUNTER_VISIBLE_FROM = 4500;

	// Only re-announce on 100-character milestones so screen readers aren't
	// interrupted on every keystroke.
	let lastAnnounced = -1;

	function updateCounter() {
		if (!messageField || !counter) return;

		const remaining = messageField.maxLength - messageField.value.length;
		const show = messageField.value.length > COUNTER_VISIBLE_FROM;

		counter.classList.toggle("hidden", !show);
		if (!show) {
			lastAnnounced = -1;
			return;
		}

		counter.textContent =
			remaining === 0
				? "You've reached the character limit \u2014 email me directly if you need more room."
				: `${remaining} characters left`;
		counter.classList.toggle("text-red-700", remaining === 0);
		counter.classList.toggle("text-ink/70", remaining !== 0);

		const milestone = remaining === 0 ? 0 : Math.ceil(remaining / 100) * 100;
		if (counterStatus && milestone !== lastAnnounced) {
			lastAnnounced = milestone;
			counterStatus.textContent = counter.textContent;
		}
	}

	messageField?.addEventListener("input", updateCounter);
	// Run once in case the browser restored a long draft on back-navigation.
	updateCounter();

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (!form || !submitButton) return;

		const formData = new FormData(form);
		const payload: Record<string, string> = {};
		formData.forEach((value, key) => {
			payload[key] = String(value);
		});

		submitButton.disabled = true;
		showStatus("Sending...");

		try {
			const response = await fetch("/", {
				method: "POST",
				headers: { "Content-Type": "application/x-www-form-urlencoded" },
				body: encode(payload),
			});

			if (!response.ok) throw new Error(`Request failed: ${response.status}`);

			form.reset();
			updateCounter();
			form.hidden = true;
			showStatus("Thanks — your message is sent. I'll get back to you within a day or two.");
		} catch {
			submitButton.disabled = false;
			showStatus("Something went wrong sending that. Please email me directly instead.", true);
		}
	});
</script>
