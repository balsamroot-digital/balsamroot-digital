---
const points = [
	{
		title: "Local",
		body: "Based in Hood River — I know what makes a Gorge tasting room different from a chain restaurant, because I live here.",
	},
	{
		title: "Responsive",
		body: "You'll get a real answer within a day, not a ticket number. It's just me — no account managers, no runaround.",
	},
	{
		title: "Honest pricing",
		body: "Flat fees for builds, clear monthly plans for upkeep. No surprise invoices.",
	},
];
---

<section class="border-y border-ink/10 bg-primary/5">
	<div class="mx-auto grid max-w-6xl gap-8 px-6 py-16 sm:grid-cols-3">
		{
			points.map((point) => (
				<div>
					<h3 class="font-head text-lg font-semibold text-ink">{point.title}</h3>
					<p class="mt-2 text-sm leading-relaxed text-ink/70">{point.body}</p>
				</div>
			))
		}
	</div>
</section>
