---
type Props = {
	href: string;
	variant?: "primary" | "accent" | "outline";
	class?: string;
};

const { href, variant = "primary", class: className = "" } = Astro.props;

const base = "inline-block rounded-md px-6 py-3 text-sm font-semibold transition-colors";
const variants = {
	primary: "bg-primary text-paper hover:bg-primary/90",
	accent: "bg-accent text-paper hover:bg-accent/90",
	outline: "border border-ink/20 text-ink hover:border-ink/40",
};
---

<a href={href} class={`${base} ${variants[variant]} ${className}`}>
	<slot />
</a>
