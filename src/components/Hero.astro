---
import { Image } from "astro:assets";
import { siteConfig } from "../data/site-config";
import Button from "./Button.astro";
import heroImage from "../assets/pexels-webbshow-2406396.jpg";
---

<section class="mx-auto max-w-6xl px-6 pt-16 pb-20 sm:pt-24 sm:pb-28">
	<div class="lg:grid lg:grid-cols-[1.1fr_1fr] lg:items-center lg:gap-14">
		<div class="max-w-2xl">
			<p class="mb-4 text-sm font-semibold uppercase tracking-wide text-accent">
				{siteConfig.region} Web Developer
			</p>
			<h1 class="font-head text-4xl font-semibold leading-tight text-ink sm:text-5xl">
				{siteConfig.tagline}
			</h1>
			<p class="mt-6 max-w-xl text-lg leading-relaxed text-ink/75">
				No agency markup, no DIY-builder compromises. A fast, clean site that makes your
				tasting room easy to find — and easy to trust — before a single visitor walks in
				the door.
			</p>
			<div class="mt-8 flex flex-wrap gap-4">
				<Button href="/portfolio" variant="primary">See the work</Button>
				<Button href="/contact" variant="outline">Get in touch</Button>
			</div>
		</div>

		<div class="mt-12 lg:mt-0">
			<div class="overflow-hidden rounded-xl">
				<Image
					src={heroImage}
					alt="A field of balsamroot flowers on the Mosier hills overlooking the Columbia River"
					widths={[500, 800, 1280]}
					sizes="(min-width: 1152px) 500px, (min-width: 1024px) 42vw, 100vw"
					format="avif"
					loading="eager"
					fetchpriority="high"
					class="aspect-[16/10] w-full object-cover object-center lg:aspect-[4/3]"
				/>
			</div>
			<p class="mt-2 text-xs text-ink/40">
				Photo by <a
					href="https://www.pexels.com/photo/photo-of-person-standing-at-flower-field-2406396/"
					target="_blank"
					rel="noopener noreferrer"
					class="underline-offset-2 hover:text-ink/70 hover:underline">Avery Nielsen-Webb</a
				>
			</p>
		</div>
	</div>
</section>
