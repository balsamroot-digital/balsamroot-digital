---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../data/site-config";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
	title: string;
	description?: string;
	/** Preview image for links shared on social media and in messages. Should
	 * be roughly 1.91:1. Pages without one share as text only. */
	image?: ImageMetadata;
};

const { title, description = siteConfig.description, image } = Astro.props;
const fullTitle = `${title} · ${siteConfig.name}`;
// The one address search engines should index for this page: `site` from astro.config,
// https, with the trailing slash Netlify serves. Other spellings redirect here.
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const shareImage = image
	? new URL((await getImage({ src: image, format: "jpg" })).src, Astro.site)
	: undefined;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href={`/favicon.ico?v=${siteConfig.iconVersion}`} sizes="any" />
		<link rel="icon" type="image/png" href={`/favicon-96.png?v=${siteConfig.iconVersion}`} sizes="96x96" />
		<link rel="apple-touch-icon" href={`/apple-touch-icon.png?v=${siteConfig.iconVersion}`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{fullTitle}</title>
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteConfig.name} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		{shareImage && <meta property="og:image" content={shareImage} />}
		<meta name="twitter:card" content={shareImage ? "summary_large_image" : "summary"} />
	</head>
	<body class="flex min-h-screen flex-col bg-paper font-body text-ink">
		<Nav />
		<main class="flex-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
